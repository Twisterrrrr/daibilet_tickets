# ============================================
# Production — переменные окружения
# Копируй в .env.production и заполняй значениями.
# ============================================

POSTGRES_DB=daibilet
POSTGRES_USER=daibilet
POSTGRES_PASSWORD=change-me-postgres

REDIS_PASSWORD=change-me-redis

APP_URL=https://daibilet.ru
CORS_ORIGIN=https://daibilet.ru,https://admin.daibilet.ru

JWT_SECRET=change-me-jwt-secret
ADMIN_INITIAL_EMAIL=admin@daibilet.ru
ADMIN_INITIAL_PASSWORD=change-me-admin

TC_API_TOKEN=
TC_WIDGET_TOKEN=

NEXT_PUBLIC_YM_ID=

# Ticket PDF (Puppeteer)
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser
PUPPETEER_HEADLESS=true
PUPPETEER_NO_SANDBOX=true
TICKET_PDF_DEBUG_ENABLED=false

