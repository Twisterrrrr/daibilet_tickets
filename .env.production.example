# ============================================
# Production — переменные окружения
# Копируй в .env.production и заполняй значениями.
# ============================================

POSTGRES_DB=daibilet
POSTGRES_USER=daibilet
POSTGRES_PASSWORD=change-me-postgres

REDIS_PASSWORD=change-me-redis

APP_URL=https://daibilet.ru
CORS_ORIGIN=https://daibilet.ru,https://admin.daibilet.ru

JWT_SECRET=change-me-jwt-secret
ADMIN_INITIAL_EMAIL=admin@daibilet.ru
ADMIN_INITIAL_PASSWORD=change-me-admin

TC_API_TOKEN=
TC_WIDGET_TOKEN=

NEXT_PUBLIC_YM_ID=

# Ticket PDF (Puppeteer)
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser
PUPPETEER_HEADLESS=true
PUPPETEER_NO_SANDBOX=true
TICKET_PDF_DEBUG_ENABLED=false

# Каталог: 0 = только лог catalog.guard.reject; 1 = фильтр sellable в публичном list (Prisma where)
CATALOG_STRICT_MODE=0

# Cloudinary — загрузка изображений (admin/supplier POST /api/v1/*/media/images)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Опционально: префикс папки в Cloudinary, без ведущего/хвостового /
CLOUDINARY_FOLDER=daibilet/prod
# Опционально: лимиты (байты / кол-во файлов за один multipart-запрос)
MEDIA_MAX_FILE_BYTES=10485760
MEDIA_MAX_FILES_PER_REQUEST=20