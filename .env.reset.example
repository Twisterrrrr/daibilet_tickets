# Reset-track env (DO NOT use in production)
#
# Goal: work with a new clean DB while keeping only:
# - cities
# - landing_pages
# - collections
# - (optional) seo_templates, tags, regions, promo_blocks, promo_collections
#
# IMPORTANT:
# - Never point TARGET_DATABASE_URL to the real production DB.
# - Run `pnpm --filter @daibilet/backend db:generate` after switching branches.

# Source DB to clone content from (current working DB / staging / snapshot)
SOURCE_DATABASE_URL="postgresql://user:pass@host:5432/daibilet_source?schema=public"

# Target DB for reset (NEW EMPTY DB)
TARGET_DATABASE_URL="postgresql://user:pass@host:5432/daibilet_reset?schema=public"

# Initial admin for reset environment
RESET_ADMIN_EMAIL="admin@example.com"
RESET_ADMIN_PASSWORD="change-me"
RESET_ADMIN_NAME="Reset Admin"

