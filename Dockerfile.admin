# ============================================
# Дайбилет — Admin Panel (Vite SPA)
# pnpm monorepo: сборка через pnpm --filter (резолв бинарников и плагинов воркспейсом).
# ============================================

# --- Stage 1: Зависимости + сборка ---
FROM node:22-alpine AS builder

RUN corepack enable && corepack prepare pnpm@latest --activate

WORKDIR /app

# Конфиги воркспейса
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml tsconfig.base.json ./

# Только пакеты, нужные для admin (shared + frontend-admin)
COPY packages/shared/package.json ./packages/shared/
COPY packages/frontend-admin/package.json ./packages/frontend-admin/

# Hoisted node_modules — бинарники и плагины резолвятся (закрывает ошибки №3, 4, 6, 7)
# pnpm install до копирования кода — кэш слоя при изменении только исходников
RUN echo "node-linker=hoisted" > .npmrc && pnpm install --frozen-lockfile

# Исходники
COPY packages/shared/ ./packages/shared/
COPY packages/frontend-admin/ ./packages/frontend-admin/

# Сборка: pnpm сам резолвит tsc, vite, плагины внутри воркспейса
RUN pnpm --filter @daibilet/shared build
RUN pnpm --filter @daibilet/frontend-admin build

# --- Stage 2: Nginx для статики ---
FROM nginx:alpine

COPY --from=builder /app/packages/frontend-admin/dist /usr/share/nginx/html

RUN printf 'server {\n\
    listen 5173;\n\
    listen [::]:5173;\n\
    root /usr/share/nginx/html;\n\
    index index.html;\n\
\n\
    location /assets/ {\n\
        expires 1y;\n\
        add_header Cache-Control "public, immutable";\n\
    }\n\
\n\
    location / {\n\
        try_files $uri $uri/ /index.html;\n\
    }\n\
}\n' > /etc/nginx/conf.d/default.conf

EXPOSE 5173

HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
  CMD wget -qO- http://localhost:5173/ || exit 1
