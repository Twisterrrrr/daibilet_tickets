# ============================================
# Дайбилет — Backend (NestJS)
# Multi-stage build для монорепо pnpm workspace
# ============================================

# --- Stage 1: Install dependencies + build ---
FROM node:22-alpine AS builder

RUN corepack enable && corepack prepare pnpm@latest --activate
RUN apk add --no-cache openssl

WORKDIR /app

# Копируем конфиги workspace
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml tsconfig.base.json ./

# Копируем package.json всех пакетов (для правильного install)
COPY packages/shared/package.json ./packages/shared/
COPY packages/backend/package.json ./packages/backend/

# Устанавливаем зависимости
RUN pnpm install --frozen-lockfile

# Копируем исходники shared + backend
COPY packages/shared/ ./packages/shared/
COPY packages/backend/ ./packages/backend/

# Генерируем Prisma Client
RUN pnpm --filter @daibilet/backend db:generate

# Собираем shared (backend зависит от него)
RUN pnpm --filter @daibilet/shared build

# Собираем backend
RUN pnpm --filter @daibilet/backend build

# pnpm deploy создаёт standalone-директорию с корректным node_modules (включая @sentry/nestjs)
RUN pnpm deploy --filter=@daibilet/backend --prod /prod/backend --legacy

# deploy не копирует .prisma/client; prisma в deps backend — генерируем явно в бандле
RUN cd /prod/backend && npx prisma generate --schema=./prisma/schema.prisma

# --- Stage 2: Production image ---
FROM node:22-alpine AS runner

RUN apk add --no-cache openssl curl

WORKDIR /app

ENV NODE_ENV=production

# Deploy-бандл: dist, prisma, node_modules (все production deps)
COPY --from=builder /prod/backend ./

EXPOSE 4000

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD curl -f http://localhost:4000/api/v1/health || exit 1

CMD ["node", "dist/main.js"]
