# ============================================
# Дайбилет — Backend (NestJS)
# Multi-stage build для монорепо pnpm workspace
# ============================================

# --- Stage 1: Install dependencies + build ---
FROM node:22-alpine AS builder

RUN corepack enable && corepack prepare pnpm@latest --activate
RUN apk add --no-cache openssl

WORKDIR /app

# Копируем конфиги workspace
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml tsconfig.base.json ./

# Копируем package.json всех пакетов (для правильного install)
COPY packages/shared/package.json ./packages/shared/
COPY packages/backend/package.json ./packages/backend/

# Устанавливаем зависимости
RUN pnpm install --frozen-lockfile

# Копируем исходники shared + backend
COPY packages/shared/ ./packages/shared/
COPY packages/backend/ ./packages/backend/

# Генерируем Prisma Client
RUN pnpm --filter @daibilet/backend db:generate

# Собираем shared: убираем composite в контейнере (из‑за него tsc эмитит только .d.ts)
RUN node -e "const fs=require('fs'); const p='/app/packages/shared/tsconfig.json'; const j=JSON.parse(fs.readFileSync(p,'utf8')); j.compilerOptions=j.compilerOptions||{}; j.compilerOptions.composite=false; j.compilerOptions.emitDeclarationOnly=false; fs.writeFileSync(p,JSON.stringify(j,null,2));" && pnpm --filter @daibilet/shared build

# Подставляем собранный shared в оба node_modules: копируем содержимое dist/. чтобы не получить dist/dist
RUN rm -rf /app/node_modules/@daibilet/shared /app/packages/backend/node_modules/@daibilet/shared && \
  mkdir -p /app/node_modules/@daibilet/shared/dist /app/packages/backend/node_modules/@daibilet/shared/dist && \
  cp /app/packages/shared/package.json /app/node_modules/@daibilet/shared/ && \
  cp -r /app/packages/shared/dist/. /app/node_modules/@daibilet/shared/dist/ && \
  cp /app/packages/shared/package.json /app/packages/backend/node_modules/@daibilet/shared/ && \
  cp -r /app/packages/shared/dist/. /app/packages/backend/node_modules/@daibilet/shared/dist/

# Собираем backend
RUN pnpm --filter @daibilet/backend build

# pnpm deploy создаёт standalone-директорию с корректным node_modules (включая @sentry/nestjs)
RUN pnpm deploy --filter=@daibilet/backend --prod /prod/backend --legacy

# Добавляем вспомогательный Prisma-скрипт в deploy-бандл, чтобы он был доступен в рантайме
COPY packages/backend/prisma/create-test-user.ts /prod/backend/prisma/create-test-user.ts

# deploy не копирует .prisma/client; prisma в deps backend — генерируем явно в бандле
RUN cd /prod/backend && npx prisma generate --schema=./prisma/schema.prisma

# --- Stage 2: Production image ---
FROM node:22-alpine AS runner

RUN apk add --no-cache openssl curl

WORKDIR /app

ENV NODE_ENV=production

# Deploy-бандл: dist, prisma, node_modules (все production deps)
COPY --from=builder /prod/backend ./

EXPOSE 4000

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD curl -f http://localhost:4000/api/v1/health || exit 1

CMD ["node", "dist/main.js"]
