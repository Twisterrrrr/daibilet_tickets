# ============================================
# Дайбилет — Supplier Panel (ЛК поставщика, Vite SPA)
# ============================================

FROM node:22-alpine AS builder

RUN corepack enable && corepack prepare pnpm@latest --activate

WORKDIR /app

COPY pnpm-workspace.yaml package.json pnpm-lock.yaml tsconfig.base.json ./
COPY packages/shared/package.json ./packages/shared/
COPY packages/shared-ui/package.json ./packages/shared-ui/
COPY packages/frontend-supplier/package.json ./packages/frontend-supplier/

RUN echo "node-linker=hoisted" > .npmrc && pnpm install --frozen-lockfile

COPY packages/shared/ ./packages/shared/
COPY packages/shared-ui/ ./packages/shared-ui/
COPY packages/frontend-supplier/ ./packages/frontend-supplier/

RUN pnpm --filter @daibilet/shared build
RUN pnpm --filter @daibilet/frontend-supplier build

FROM nginx:alpine

COPY --from=builder /app/packages/frontend-supplier/dist /usr/share/nginx/html

RUN printf 'server {\n\
    listen 5174;\n\
    listen [::]:5174;\n\
    root /usr/share/nginx/html;\n\
    index index.html;\n\
\n\
    location /assets/ {\n\
        expires 1y;\n\
        add_header Cache-Control "public, immutable";\n\
    }\n\
\n\
    location / {\n\
        try_files $uri $uri/ /index.html;\n\
    }\n\
}\n' > /etc/nginx/conf.d/default.conf

EXPOSE 5174

HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
  CMD wget -qO- http://localhost:5174/ || exit 1
