# ============================================
# STAGING .env — отдельные секреты от prod!
# YooKassa — sandbox ключи
# ============================================

POSTGRES_DB=daibilet_staging
POSTGRES_USER=daibilet
POSTGRES_PASSWORD=

REDIS_PASSWORD=

JWT_SECRET=
ADMIN_INITIAL_EMAIL=admin@daibilet.ru
ADMIN_INITIAL_PASSWORD=StagingAdmin2025!

APP_URL=https://staging.daibilet.ru
CORS_ORIGIN=https://staging.daibilet.ru,https://admin-staging.daibilet.ru,https://api-staging.daibilet.ru

# Ticketscloud: для импорта (gRPC) и виджета. На staging — stage-сервер по умолчанию.
TC_API_TOKEN=
TC_WIDGET_TOKEN=
# gRPC endpoint: prod = simple.ticketscloud.com:443, staging = simple.stage.freetc.net:443
TC_GRPC_ENDPOINT=simple.stage.freetc.net:443

YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

NEXT_PUBLIC_YM_ID=

# Опционально: снимает лимит Docker Hub 429 при pull (nginx и т.д.)
# DOCKERHUB_USER=
# DOCKERHUB_TOKEN=
