    "@prisma/client": "7.7.0",
    "@sentry/nestjs": "^10.38.0",
    "@sentry/profiling-node": "^10.38.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.30.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cloudinary": "^2.9.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "handlebars": "^4.7.8",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.0",
    "multer": "^2.0.0",
    "nestjs-pino": "^4.6.0",
