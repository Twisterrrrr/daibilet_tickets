    "pino-http": "^11.0.0",
    "pg": "^8.13.0",
    "prisma": "7.7.0",
    "puppeteer": "^24.8.2",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.34.5",
    "xlsx": "^0.18.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/pg": "^8.11.11",
