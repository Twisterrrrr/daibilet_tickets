{
  "name": "@daibilet/backend",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "predev": "prisma generate",
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main",
    "start:prod": "node dist/main",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint \"{src,test}/**/*.ts\" --fix",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:prod": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:seed:tep-widgets": "npx tsx prisma/seed-teplohod-widgets.ts",
    "db:seed:regions": "npx tsx prisma/seed-regions.ts",
    "db:seed:qf": "npx tsx prisma/seed-query-filters.ts",
    "db:seed:supplier-finance": "npx tsx prisma/seed-supplier-finance.ts",
    "db:seed:finance-docs-demo": "npx tsx prisma/seed-finance-docs-demo.ts",
    "db:seed:buyer-test": "npx tsx prisma/seed-buyer-account-test.ts",
    "db:seed:event-sessions-test": "npx tsx prisma/seed-event-sessions-test.ts",
    "db:seed:scenarios": "npx tsx prisma/seed-scenarios.ts",
    "db:seed:foundation-fixtures": "npx tsx prisma/seed-foundation-fixtures.ts",
    "finance:print-samples": "npx tsx scripts/generate-finance-print-samples.ts",
    "sync:tep": "npx tsx scripts/sync-teplohod.ts",
    "tep:fixture-bridge": "npx tsx scripts/teplohod-fixture-bridge.ts",
    "tep:export-fixtures": "npx tsx scripts/export-teplohod-snapshot.ts",
    "sync:tc-orders-mirror": "npx tsx scripts/sync-tc-orders-mirror.ts",
    "sync:tc-refund-requests-mirror": "npx tsx scripts/sync-tc-refund-requests-mirror.ts",
    "parse:teplohod-email": "npx tsx scripts/parse-teplohod-email.ts",
    "full:sync": "npx tsx scripts/full-sync.ts",
    "check:sync-env": "npx tsx scripts/check-sync-env.ts",
    "backfill:grouping": "npx tsx scripts/backfill-event-grouping.ts",
    "event-groups:create": "npx tsx scripts/auto-create-event-groups.ts",
    "reclassify:dry": "npx tsx prisma/reclassify-events.ts",
    "reclassify:apply": "npx tsx prisma/reclassify-events.ts --apply",
    "check:categorization": "npx tsx prisma/check-categorization.ts",
    "audit:tags": "npx tsx scripts/auditTags.ts",
    "migrate:legacy-tags": "npx tsx scripts/migrateLegacyTags.ts",
    "backfill:format-subcategories": "npx tsx scripts/backfill-format-subcategories.ts",
    "data:trim-subcategory-links": "npx tsx scripts/trim-event-subcategory-links.ts",
    "data:backfill-legacy-subcategory-links": "npx tsx scripts/backfill-legacy-subcategory-links.ts",
    "data:validate-legacy-subcategory-links": "npx tsx scripts/validate-legacy-subcategory-links.ts",
    "catalog:backfill": "npx tsx scripts/catalogBackfill.ts",
    "catalog:legacy-classification": "npx tsx scripts/legacyClassificationFix.ts",
    "catalog:cleanup-links": "npx tsx scripts/cleanupLinks.ts",
    "verify:tags-post-migration": "npx tsx scripts/postMigrationVerifyTags.ts",
    "ensure-partitions": "npx tsx scripts/ensure-event-sessions-partitions.ts",
    "fix:teplohod-river": "npx tsx prisma/fix-teplohod-river-excursions.ts",
    "gen:proto": "node -e \"require('fs').mkdirSync('src/generated',{recursive:true})\" && protoc --plugin=protoc-gen-ts_proto=./node_modules/ts-proto/protoc-gen-ts_proto --ts_proto_out=./src/generated --ts_proto_opt=esModuleInterop=true --ts_proto_opt=outputServices=false -I ./proto/tc-simple -I ./node_modules/google-proto-files ./proto/tc-simple/events.proto ./proto/tc-simple/venues.proto ./proto/tc-simple/geo.proto ./proto/tc-simple/generic.proto ./proto/tc-simple/meta_events.proto ./proto/tc-simple/mods.proto",
    "db:studio": "prisma studio",
    "data:seed:qa-ux-landing": "npx tsx scripts/seed-test-landing-composition.ts",
    "data:cleanup-dev-city-landings": "npx tsx scripts/cleanup-dev-city-landings.ts"
  },
  "dependencies": {
    "@daibilet/shared": "workspace:*",
    "@grpc/grpc-js": "^1.14.3",
