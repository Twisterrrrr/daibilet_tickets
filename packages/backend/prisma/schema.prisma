  COMMISSION
  REFUND
  PAYOUT
  ADJUSTMENT
}

enum SupplierDocumentType {
  AGENT_REPORT
  SERVICE_ACT
  UPD
  INVOICE
  VAT_INVOICE
  COMMISSION_ACT
  PAYOUT_STATEMENT
}

enum SupplierDocumentStatus {
  DRAFT
  GENERATED
  ISSUED
  SENT
  DELIVERED
  SIGNED
  FAILED
  CANCELED
}

enum ClosingDocumentMode {
  UPD
  ACT
